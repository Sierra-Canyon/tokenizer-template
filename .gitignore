# Your corpus. Real text, often large, and not something to push.
data/*
!data/README.md
*.txt

# Trained artifacts. Regenerate them, do not commit them.
*.model
*.vocab
cache/
*.npy

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Secrets. The guard blocks these at commit time as well; this is belt and braces.
.env
.env.*
*.pem
*.key

.DS_Store
